# Public base URL (used for emails, Stripe return URLs, canonical tags)
APP_URL=http://localhost:3000

# Stripe (leave blank to use the built-in demo checkout; use test keys first)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# "test" or "live" — live is only used after the pre-launch checklist (G.8)
STRIPE_MODE=test

# Resend (leave blank and emails are written to the Control Room outbox instead)
RESEND_API_KEY=
RESEND_FROM="MedTwenty <newsroom@mail.medtwenty.com>"
RESEND_WEBHOOK_SECRET=

# n8n pipeline (Phase A)
INGEST_API_SECRET=change-me
N8N_DRAFT_URL=
N8N_TRIGGER_SECRET=

# Where the SQLite database lives
DATABASE_PATH=./data/medtwenty.db
